# Required in production. The one shared admin password (blueprint section 2).
ADMIN_PASSWORD=

# Set automatically when you add Neon Postgres from the Vercel Storage tab.
# Leave unset locally to use the embedded database in .data/.
DATABASE_URL=

# Optional. Signs session cookies. If unset, one is derived from ADMIN_PASSWORD and DATABASE_URL.
SESSION_SECRET=

# Optional. The leader code to start with on a brand-new database. Change it anytime in Admin > Settings.
LEADER_CODE=
